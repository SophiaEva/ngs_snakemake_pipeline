#Run fastqc on all fastq.gz files present in the given folder
#Segregate output in samplewise folder
#Coding by: Sophia EA
#Code Optimized by:Vyomesh J

import os
import glob

# Load config file
raw_data_dir = os.path.abspath(config["raw_data_dir"])
output_dir = os.path.abspath(config["output_dir"])
reference = os.path.abspath(config["reference"])
known_sites = config["known_sites"]
bed_file = os.path.abspath(config["bed_file"])

# Get all FASTQ files
fastq_files = glob.glob(f"{raw_data_dir}/**/*_R[12]_001.fastq.gz", recursive=True)

# Extract sample names
samples = sorted(set(
    os.path.basename(f)
      .replace("_R1_001.fastq.gz", "")
      .replace("_R2_001.fastq.gz", "")
    for f in fastq_files
))

# Map each sample to its nested directory
sample_to_batch = {
    os.path.basename(f)
        .replace("_R1_001.fastq.gz", "")
        .replace("_R2_001.fastq.gz", ""):
    os.path.relpath(os.path.dirname(f), raw_data_dir)
    for f in fastq_files
}

rule all:
    input:
        expand("{output_dir}/{sample}/{sample}_recal.bam", output_dir=output_dir, sample=samples),
        expand("{output_dir}/{sample}/{sample}_recal.bam.bai", output_dir=output_dir, sample=samples),
        expand("{output_dir}/{sample}/{sample}_dedup.vcf", output_dir=output_dir, sample=samples)

rule fastqc:
    input:
        fq = lambda wc: f"{raw_data_dir}/{sample_to_batch[wc.sample]}/{wc.sample}_{wc.read}.fastq.gz"
    output:
        html = "{output_dir}/{sample}/{sample}_{read}_fastqc.html",
        zip  = "{output_dir}/{sample}/{sample}_{read}_fastqc.zip"
    log:
        "{output_dir}/{sample}/{sample}_{read}.fastqc.log"
    threads: 2
    shell:
        """
        mkdir -p {output_dir}/{wildcards.sample}
        fastqc {input.fq} --outdir {output_dir}/{wildcards.sample} &> {log}
        """

rule bwa_mem:
    input:
        r1 = lambda wc: f"{raw_data_dir}/{sample_to_batch[wc.sample]}/{wc.sample}_R1_001.fastq.gz",
        r2 = lambda wc: f"{raw_data_dir}/{sample_to_batch[wc.sample]}/{wc.sample}_R2_001.fastq.gz",
        ref = reference
    output:
        sam = temp("{output_dir}/{sample}/{sample}.sam")
    threads: 4
    shell:
        """
        mkdir -p {output_dir}/{wildcards.sample}
        bwa mem -t {threads} -R '@RG\\tID:{wildcards.sample}\\tSM:{wildcards.sample}\\tPL:ILLUMINA' \
            {input.ref} {input.r1} {input.r2} > {output.sam}
        """

rule sam_to_sorted_bam:
    input:
        sam = rules.bwa_mem.output.sam
    output:
        bam = "{output_dir}/{sample}/{sample}.sorted.bam"
    shell:
        """
        samtools view -bS {input.sam} | samtools sort -o {output.bam}
        """

rule mark_duplicates:
    input:
        bam = rules.sam_to_sorted_bam.output.bam
    output:
        bam = "{output_dir}/{sample}/{sample}_raw.sorted.dedup.bam",
        metrics = "{output_dir}/{sample}/{sample}_metrics.txt"
    log:
        "{output_dir}/{sample}/{sample}.dedup.log"
    shell:
        """
        gatk MarkDuplicates -I {input.bam} -O {output.bam} -M {output.metrics} &> {log}
        """

rule index_dedup_bam:
    input:
        bam = rules.mark_duplicates.output.bam
    output:
        bai = "{output_dir}/{sample}/{sample}_raw.sorted.dedup.bam.bai"
    shell:
        "samtools index {input.bam}"

rule base_recalibrator:
    input:
        bam = rules.mark_duplicates.output.bam,
        bai = rules.index_dedup_bam.output.bai,
        ref = reference
    output:
        recal_table = "{output_dir}/{sample}/{sample}_recal.table"
    log:
        "{output_dir}/{sample}/{sample}_baseRecal.log"
    params:
        known_sites = " ".join(f"--known-sites {site}" for site in known_sites)
    shell:
        """
        gatk BaseRecalibrator \
            -R {input.ref} \
            -I {input.bam} \
            {params.known_sites} \
            -O {output.recal_table} &> {log}
        """

rule apply_bqsr:
    input:
        bam = rules.mark_duplicates.output.bam,
        recal_table = rules.base_recalibrator.output.recal_table,
        ref = reference
    output:
        bam = "{output_dir}/{sample}/{sample}_recal.bam"
    shell:
        """
        gatk ApplyBQSR \
            -R {input.ref} \
            -I {input.bam} \
            --bqsr-recal-file {input.recal_table} \
            -O {output.bam}
        """

rule index_recal_bam:
    input:
        bam = rules.apply_bqsr.output.bam
    output:
        bai = "{output_dir}/{sample}/{sample}_recal.bam.bai"
    shell:
        "samtools index {input.bam}"

rule haplotype_caller:
    input:
        bam = rules.apply_bqsr.output.bam,
        bai = rules.index_recal_bam.output.bai,
        ref = reference
    output:
        vcf = "{output_dir}/{sample}/{sample}_dedup.vcf"
    shell:
        """
        gatk HaplotypeCaller \
            -R {input.ref} \
            -I {input.bam} \
            -O {output.vcf} \
            -L {bed_file}
        """

